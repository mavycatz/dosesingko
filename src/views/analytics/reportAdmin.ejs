  <div class="col-md-4">
    <div class="card p-3 text-center shadow-sm" style="background-color:#fff; color:#333; border-radius:0.75rem; transition: transform 0.2s;">
      <div class="mb-2">
        <i class="fas fa-print" style="font-size:1.8rem; color:#000;"></i>
      </div>
      <h6 class="mb-1">Printable Reports</h6>
      <h3><%= stats.printableReports %></h3>
    </div>
