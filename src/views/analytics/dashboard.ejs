<script>
  let inactivityTime = function () {
    let timer;
    const logoutTime = 3 * 60 * 1000; // 3 minutes in milliseconds

    function resetTimer() {
      clearTimeout(timer);
      timer = setTimeout(() => {
        alert('You have been inactive for 3 minutes. Redirecting to login.');
        window.location.href = '/users/login'; // change to your login route
      }, logoutTime);
    }

    // Events that reset the timer
    window.onload = resetTimer;
    document.onmousemove = resetTimer;
    document.onkeypress = resetTimer;
    document.ontouchstart = resetTimer;
    document.onclick = resetTimer;
    document.onscroll = resetTimer;
  };

  inactivityTime();
</script>

