</div>
<!-- Average Ratings and Rating Distribution Section -->
<div style="display: flex; gap: 20px; flex-wrap: nowrap; justify-content: space-between; align-items: stretch; margin-top: 20px; margin-bottom: 20px;">
  
  <!-- Average Ratings by Category -->
  <div style="flex: 1; min-width: 0;">
