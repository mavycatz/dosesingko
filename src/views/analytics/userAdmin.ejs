        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card p-3 shadow-sm d-flex flex-column" style="border-radius:12px; background-color:#fff; color:#000;">
        <h6 style="margin:0; font-weight:400;">Active Users</h6>
        <div class="d-flex justify-content-between align-items-baseline">
          <h3 style="margin:0; font-weight:700;"><%= activeUsers %></h3>
          <i class="bi bi-person-check-fill" style="font-size:1rem; color:#000;"></i>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card p-3 shadow-sm d-flex flex-column" style="border-radius:12px; background-color:#fff; color:#000;">
