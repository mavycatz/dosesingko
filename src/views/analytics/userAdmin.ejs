<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 25px;">
  <div>
    <h4 style="font-size: 1.5rem; font-weight: 700; margin:0;">User Management</h4>
    <p style="color: gray; font-size: 0.9rem; margin-top: 5px;">Manage system users, roles, and permissions</p>
  </div>
<% if (successMessage) { %>
  <div style="padding:12px 20px; background:#e0ffe0; border:1px solid #00aa00; color:#006600; border-radius:6px; margin-bottom:15px; font-weight:500;">
    <%= successMessage %>
