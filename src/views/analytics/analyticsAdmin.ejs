<script>
document.addEventListener("DOMContentLoaded", async () => {
  const chartCanvas = document.getElementById("correlation-report-chart");
  const ctx = chartCanvas.getContext("2d");

  let data;
  try {
    const res = await fetch("/analytics/reports/correlation");
    data = await res.json();
  } catch (e) {
    console.warn(" Using sample data because fetch failed.");
    data = {
      success: true,
      correlations: [
        { category: "FoodQuality", correlation: 0.82 },
        { category: "Ambiance", correlation: 0.68 },
        { category: "Service", correlation: 0.55 },
        { category: "ValueForMoney", correlation: 0.33 },
        { category: "StaffAttitude", correlation: 0.72 },
        { category: "BartenderAttitude", correlation: 0.45 }
      ]
    };
  }

  if (!data.success) return console.error(" Failed to load correlation report");

  const { correlations } = data;

  new Chart(ctx, {
    type: "bar",
    data: {
      labels: correlations.map(c => c.category.replace(/([A-Z])/g, ' $1')),
      datasets: [{
        label: "Correlation with Overall Satisfaction",
        data: correlations.map(c => c.correlation),
        backgroundColor: correlations.map(c =>
          c.correlation >= 0.7 ? "#111" :
          c.correlation >= 0.4 ? "#444" :
          c.correlation >= 0.2 ? "#777" :
          "#ccc"
        ),
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 1200, easing: "easeOutQuart" },
      scales: {
        y: {
          beginAtZero: true,
          max: 1,
          title: { display: true, text: "Correlation Coefficient", color:"#111", font: { weight:'400', size:11 } },
          ticks: { color:"#111", font:{ size:12 } },
          grid: { color:"#eee" }
        },
        x: {
          ticks: { color:"#111", font:{ weight:'500', size:12 } },
          grid: { display:false }
        }
      },
      plugins: {
        tooltip: {
          backgroundColor:"#111",
          titleColor:"#fff",
          bodyColor:"#fff",
          callbacks: { label: ctx => `r = ${ctx.parsed.y.toFixed(2)}` }
        },
        legend: { display: false }
      }
    }
  });

  const summaryText = correlations.map(c => {
    const strength =
      c.correlation >= 0.7 ? "Strong" :
      c.correlation >= 0.4 ? "Moderate" :
      c.correlation >= 0.2 ? "Weak" : "No";
    return `<li style="margin-bottom:6px;"><b style="color:#111;">${c.category.replace(/([A-Z])/g, ' $1')}</b>: ${strength} correlation <span style="color:#666;">(r = ${c.correlation.toFixed(2)})</span></li>`;
  }).join("");

  document.getElementById("correlation-summary").innerHTML =
    `<ul style="margin:0; padding-left:20px;">${summaryText}</ul>`;
});
</script>


