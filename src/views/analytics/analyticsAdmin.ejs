  <div id="approvalMessage" 
     style="display:none; position:fixed; margin-top:20px; left:50%; transform:translateX(-50%); 
            z-index:1050; padding:8px 15px; border-radius:12px; 
            max-width:300px; text-align:center; font-weight:normal;">
  </div>

  <div style="font-size: 0.8rem; margin-top: 5px; margin-bottom: 10px; margin-left: 25px;">
