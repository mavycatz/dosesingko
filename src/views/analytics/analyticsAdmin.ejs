async function renderTopCustomerIssues() {
  const container = document.getElementById("top-issues-container");
  container.innerHTML = "";

  try {
    const query = getActiveFilters();
    const res = await fetch(`/analytics/reports/top-issues?${query}`);
    const data = await res.json();
    const issues = data.issues;

    if (!issues || issues.length === 0) {
      const video = document.createElement("video");
      video.src = "/images/coffeegif.mp4";
      video.autoplay = true;
      video.loop = true;
      video.muted = true;
      video.style.width = "150px";
      video.style.borderRadius = "8px";
      container.appendChild(video);

      const msg = document.createElement("p");
      msg.textContent = "Everything all good! No issues.";
      msg.style.marginTop = "10px";
      msg.style.color = "#333";
      msg.style.fontWeight = "500";
      msg.style.textAlign = "center";
      container.appendChild(msg);
      return;
    }

    const totalMentions = issues.reduce((sum, i) => sum + i.count, 0);
    const maxCount = Math.max(...issues.map(i => i.count));

    issues.forEach(issue => {
      const wrapper = document.createElement("div");
      wrapper.style.marginBottom = "18px";
      wrapper.style.borderBottom = "1px solid #ccc";
      wrapper.style.paddingBottom = "10px";

      const topRow = document.createElement("div");
      topRow.style.display = "flex";
      topRow.style.justifyContent = "space-between";
      topRow.style.alignItems = "center";
      topRow.style.marginBottom = "6px";

      const leftSpan = document.createElement("div");
      leftSpan.style.display = "flex";
      leftSpan.style.alignItems = "center";
      leftSpan.style.gap = "8px";

      const rankCircle = document.createElement("div");
      rankCircle.textContent = `#${issue.rank}`;
      rankCircle.style.width = "24px";
      rankCircle.style.height = "24px";
      rankCircle.style.borderRadius = "50%";
      rankCircle.style.background = "#111";
      rankCircle.style.color = "#fff";
      rankCircle.style.display = "flex";
      rankCircle.style.alignItems = "center";
      rankCircle.style.justifyContent = "center";
      rankCircle.style.fontSize = "12px";
      rankCircle.style.fontWeight = "600";

      const wordSpan = document.createElement("span");
      wordSpan.textContent = issue.word.charAt(0).toUpperCase() + issue.word.slice(1);
      wordSpan.style.fontWeight = "600";
      wordSpan.style.color = "#111";

      leftSpan.appendChild(rankCircle);
      leftSpan.appendChild(wordSpan);
      topRow.appendChild(leftSpan);

      const categorySpan = document.createElement("span");
      categorySpan.textContent = issue.category || "Unknown";
      categorySpan.style.fontStyle = "italic";
      categorySpan.style.color = "#555";
      categorySpan.style.fontSize = "12px";
      topRow.appendChild(categorySpan);

      wrapper.appendChild(topRow);

      const barContainer = document.createElement("div");
      barContainer.style.background = "#eee";
      barContainer.style.borderRadius = "8px";
      barContainer.style.height = "24px";
      barContainer.style.overflow = "hidden";
      barContainer.style.marginBottom = "4px";

      const bar = document.createElement("div");
      bar.style.height = "100%";
      bar.style.borderRadius = "8px";
      bar.style.width = `${(issue.count / maxCount) * 100}%`;
      bar.style.background = "#444";
      barContainer.appendChild(bar);
      wrapper.appendChild(barContainer);

      const infoRow = document.createElement("div");
      infoRow.style.textAlign = "right";
      infoRow.style.fontSize = "12px";
      infoRow.style.color = "#555";
      infoRow.textContent = `${issue.count} mentions (${((issue.count / totalMentions) * 100).toFixed(1)}%)`;
      wrapper.appendChild(infoRow);

      container.appendChild(wrapper);
    });

  } catch (err) {
    console.error("Error rendering top customer issues:", err);
  }
}

