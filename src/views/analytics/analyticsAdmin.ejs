<script>
async function fetchHeatmapData() {
  const from = document.getElementById("dateFrom")?.value || "";
  const to = document.getElementById("dateTo")?.value || "";
  const cat = document.getElementById("category")?.value || "";
  const type = document.getElementById("customerType")?.value || "";

  console.log("Fetching heatmap for:", { from, to, cat, type });

  const fromText = from ? new Date(from).toLocaleDateString("en-US",{month:'short',day:'numeric'}) : "Start";
  const toText = to ? new Date(to).toLocaleDateString("en-US",{month:'short',day:'numeric'}) : "End";
  const dateLabel = (!from && !to) ? "Current Week" : (from && to ? `${fromText} - ${toText}` : from ? `From ${fromText}` : `Until ${toText}`);
  document.getElementById("heatmap-subtitle").textContent = `Showing data for: ${dateLabel} - ${cat||"All Categories"} - ${type||"All Types"}`;

  const queryParams = {};
  if (from) queryParams.startDate = from;
  if (to) queryParams.endDate = to;
  if (cat) queryParams.category = cat;
  if (type) queryParams.customerType = type;
  const query = new URLSearchParams(queryParams).toString();

  try {
  const res = await fetch(`/analytics/reports/heatmap-data?${query}`);
    if (!res.ok) throw new Error("Failed to fetch heatmap data");
    const { heatmapData } = await res.json();
    console.log("Received heatmapData:", heatmapData);

    const days = ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"];
    const periods = ["Morning","Afternoon","Evening"];
    let tableHTML = `<table style="border-collapse:separate; border-spacing:5px; text-align:center; font-family:Arial,sans-serif; min-width:700px;">
      <thead><tr><th>Time / Day</th>${days.map(d=>`<th>${d.substring(0,3)}</th>`).join('')}</tr></thead><tbody>`;

    periods.forEach(period=>{
      tableHTML += `<tr><td style="font-weight:600; text-align:left;">${period}</td>`;
      days.forEach(day=>{
        const key = `${day}-${period}`;
        const data = heatmapData[key] || { avgRating:0, totalFeedback:0 };
        let bg="#eee", color="#444";
        if(data.avgRating>=4){ bg="#111"; color="#fff"; }
        else if(data.avgRating>=3.5){ bg="#555"; color="#fff"; }
        else if(data.avgRating>=3){ bg="#888"; color="#fff"; }

        tableHTML += `<td style="padding:6px; border-radius:4px; background:${bg}; color:${color};">
          <div class="avg">${data.avgRating>0?"★":"☆"}</div>
          <div class="count" style="font-size:0.75rem;">${data.totalFeedback}</div>
        </td>`;
      });
      tableHTML += `</tr>`;
    });

    tableHTML += `</tbody></table>`;
    document.getElementById("heatmap-table-container").innerHTML = tableHTML;

    const ratings = Object.values(heatmapData).filter(d=>d.totalFeedback>0);
    const insightsList = document.getElementById("heatmap-insights");
    if(ratings.length){
      const maxRating = Math.max(...ratings.map(d=>d.avgRating));
      const minRating = Math.min(...ratings.map(d=>d.avgRating));
      const maxFeedback = Math.max(...ratings.map(d=>d.totalFeedback));
      insightsList.innerHTML = `
        <li>Highest satisfaction: <span style="font-weight:600; color:#111;">${maxRating.toFixed(1)} ★</span></li>
        <li>Lowest satisfaction: <span style="font-weight:600; color:#111;">${minRating.toFixed(1)} ★</span></li>
        <li>Peak feedback volume: <span style="font-weight:600; color:#111;">${maxFeedback} reviews</span></li>
        <li>Most consistent: <span style="font-weight:600; color:#111;">Check weekday patterns</span></li>`;
    } else {
      insightsList.innerHTML = "<li>No feedback data available</li>";
    }

  } catch(err){
    console.error("Error fetching heatmap:", err);
  }
}

function updateTime(){
  const now = new Date();
  const options={ weekday:'short', year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', second:'2-digit' };
  document.getElementById("live-time").textContent = now.toLocaleDateString('en-US', options);
}
setInterval(updateTime,1000);
updateTime();

["dateFrom","dateTo","category","customerType"].forEach(id=>{
  const el=document.getElementById(id);
  if(el) el.addEventListener("change", fetchHeatmapData);
});

fetchHeatmapData();
</script>
