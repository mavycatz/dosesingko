<script>
async function renderSentimentTrendsChart() {
  const params = new URLSearchParams({
    dateFrom: dateFrom.value,
    dateTo: dateTo.value,
    customerType: customerType.value
  });

  const response = await fetch(`/analytics/trends/sentiment?${params.toString()}`);
  const data = await response.json();

  const ctx = document.getElementById('sentiment-trends-chart').getContext('2d');

  if (window.sentimentChart) window.sentimentChart.destroy();

  const shades = { Negative: 'rgba(0,0,0,0.3)', Neutral: 'rgba(0,0,0,0.6)', Positive: 'rgba(0,0,0,0.9)' };

  const datasets = [];
  Object.keys(data).forEach(key => {
    if (key === 'labels' || key === 'topWords') return;
    ['Negative','Neutral','Positive'].forEach(sentiment => {
      datasets.push({
        label: `${key} - ${sentiment}`,
        data: data[key][sentiment],
        fill: true,
        borderColor: shades[sentiment],
        backgroundColor: shades[sentiment],
        tension: 0.3,
        pointStyle: 'circle',
        pointRadius: 6,
        pointBackgroundColor: shades[sentiment],
        pointBorderColor: shades[sentiment],
        pointHoverRadius: 8
      });
    });
  });

  window.sentimentChart = new Chart(ctx, {
    type: 'line',
    data: { labels: data.labels, datasets: datasets },
    options: {
      responsive: true,
      interaction: { mode: 'nearest', intersect: true },
      stacked: true,
      scales: {
        y: { beginAtZero: true, title: { display: true, text: 'Number of Respondents', color: '#000' }, ticks: { color: '#000' }, grid: { color: '#eee' } },
        x: { title: { display: true, text: 'Weeks', color: '#000' }, ticks: { color: '#000' }, grid: { color: '#eee' } }
      },
      plugins: {
        legend: { display: false },
        tooltip: { mode: 'index', intersect: false, titleColor: '#000', bodyColor: '#000', backgroundColor: '#fff', borderColor: '#ccc', borderWidth: 1 }
      },
      onClick: (evt, elements) => {
        if (!elements.length) return;
        const weekIndex = elements[0].index;

        window.sentimentChart.data.datasets.forEach(ds => {
          ds.pointRadius = ds.data.map((_, i) => i === weekIndex ? 8 : 4);
        });
        window.sentimentChart.update();

        let summaryHTML = `<strong>${data.labels[weekIndex]}</strong><ul>`;
        let totalNeg = 0, totalNeu = 0, totalPos = 0;

        Object.keys(data).forEach(key => {
          if (key === 'labels' || key === 'topWords') return;
          const neg = data[key].Negative[weekIndex] || 0;
          const neu = data[key].Neutral[weekIndex] || 0;
          const pos = data[key].Positive[weekIndex] || 0;
          totalNeg += neg; totalNeu += neu; totalPos += pos;

          summaryHTML += `<li><strong>${key}</strong> - Positive: ${pos}, Neutral: ${neu}, Negative: ${neg}`;
          if (data.topWords && data.topWords[key] && data.topWords[key][weekIndex]) {
            summaryHTML += `<br>Top Words: ${data.topWords[key][weekIndex].join(', ')}`;
          }
          summaryHTML += `</li>`;
        });
        summaryHTML += '</ul>';
        document.getElementById('summary-content').innerHTML = summaryHTML;

        const totalResponses = totalNeg + totalNeu + totalPos;
        const negPercent = ((totalNeg / totalResponses) * 100).toFixed(1);
        const posPercent = ((totalPos / totalResponses) * 100).toFixed(1);

        let insightsHTML = `<strong>Key Insights:</strong><br>`;
        let recommendationsHTML = `<strong>Recommendations / Conclusion:</strong><br>`;

        insightsHTML += `• Positive feedback: ${posPercent}%<br>`;
        insightsHTML += `• Negative feedback: ${negPercent}%<br>`;

        if (posPercent > 50 && posPercent > negPercent) {
            insightsHTML += `• Majority of customers are satisfied. Maintain current strengths.<br>`;
            recommendationsHTML += `• Continue what is working well.<br>• Reinforce positive experiences.<br>• Monitor trends weekly for proactive adjustments.<br>`;
        } else if (negPercent > 30) {
            insightsHTML += `• High negative feedback detected. Focus on improving weak areas.<br>`;
            recommendationsHTML += `• Investigate main complaints.<br>• Address weak areas to improve satisfaction.<br>• Monitor trends weekly for proactive adjustments.<br>`;
        } else {
            insightsHTML += `• Feedback is mixed. Monitor trends closely.<br>`;
            recommendationsHTML += `• Observe patterns and adjust strategies as needed.<br>• Monitor trends weekly for proactive adjustments.<br>`;
        }

        document.getElementById('summary-insights').innerHTML = insightsHTML + recommendationsHTML;
      }
    }
  });
}

[dateFrom, dateTo, customerType].forEach(el => el.addEventListener('change', renderSentimentTrendsChart));
document.addEventListener('DOMContentLoaded', renderSentimentTrendsChart);
</script>
<script>
async function renderWeeklySeriesChart() {
  const params = new URLSearchParams({
    dateFrom: document.getElementById('dateFrom')?.value || '',
    dateTo: document.getElementById('dateTo')?.value || '',
    category: document.getElementById('category')?.value || '',
    customerType: document.getElementById('customerType')?.value || ''
  });

  const response = await fetch(`/analytics/weekly-feedback-volume-rating?${params.toString()}`);
  const data = await response.json();

  const ctx = document.getElementById('weekly-series-chart').getContext('2d');
  const weekLabels = data.labels; 
  const totalFeedback = data.totalFeedback;
  const avgRating = data.avgRating;

  if (window.weeklySeriesChart) window.weeklySeriesChart.destroy();

  window.weeklySeriesChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: weekLabels,
      datasets: [
        {
          label: 'Feedback Volume',
          data: totalFeedback,
          type: 'bar',
          backgroundColor: '#ccc',
          borderColor: '#000',
          borderWidth: 1,
          yAxisID: 'yFeedback'
        },
        {
          label: 'Rating',
          data: avgRating,
          type: 'line',
          borderColor: '#000',
          backgroundColor: 'rgba(0,0,0,0.6)',
          fill: false,
          tension: 0.3,
          yAxisID: 'yRating',
          pointStyle: 'circle',
          pointRadius: 6,
          pointBackgroundColor: '#000',
          pointHoverRadius: 8
        }
      ]
    },
    options: {
      responsive: true,
      interaction: { mode: 'nearest', intersect: true },
      scales: {
        yFeedback: {
          type: 'linear',
          position: 'left',
          title: { display: true, text: 'Total Feedback', color: '#000' },
          beginAtZero: true,
          ticks: { color: '#000' },
          grid: { color: '#eee' }
        },
        yRating: {
          type: 'linear',
          position: 'right',
          min: 0,
          max: 5,
          title: { display: true, text: 'Rating', color: '#000' },
          ticks: { color: '#000' },
          grid: { drawOnChartArea: false, color: '#eee' }
        },
        x: {
          ticks: { color: '#000' },
          grid: { color: '#eee' }
        }
      },
      plugins: {
        legend: { display: false },
        tooltip: {
          mode: 'index',
          intersect: false,
          backgroundColor:'#fff',
          titleColor:'#000',
          bodyColor:'#000',
          borderColor:'#ccc',
          borderWidth:1
        }
      },
      onClick: (evt, elements) => {
        if (!elements.length) return;
        const weekIndex = elements[0].index;

        window.weeklySeriesChart.data.datasets.forEach(ds => {
          if (ds.type === 'line') ds.pointRadius = ds.data.map((_, i) => i === weekIndex ? 8 : 6);
        });
        window.weeklySeriesChart.update();

        const neg = totalFeedback[weekIndex] || 0;
        const avg = avgRating[weekIndex] || 0;

        document.getElementById('weekly-series-summary-content').innerHTML = `
          <strong>${weekLabels[weekIndex]}</strong>
          <ul>
            <li>Average Rating: ${avg.toFixed(2)}</li>
            <li>Total Feedback: ${neg}</li>
          </ul>
        `;

        let insightsText = `• Average Rating: ${avg.toFixed(2)}<br>• Feedback Volume: ${neg}<br>`;
        if (avg >= 4) insightsText += '• Maintain current performance and customer satisfaction.<br>';
        if (avg < 3) insightsText += '• Average rating below standard, investigate reasons and take corrective actions.<br>';
        if (avg >= 3 && avg < 4) insightsText += '• Ratings are decent, consider minor improvements based on feedback.<br>';

        let recommendationsText = '<strong>Recommendations / Conclusion:</strong><br>';
        if (avg >= 4) recommendationsText += '• Continue best practices to maintain high ratings.<br>';
        if (avg < 4) recommendationsText += '• Focus on improvement strategies to increase satisfaction.<br>';
        recommendationsText += '• Monitor weekly trends.<br>• Address negative feedback if any.<br>';

        document.getElementById('weekly-series-insights').innerHTML = `<strong>Key Insights:</strong><br>${insightsText}${recommendationsText}`;
      }
    }
  });
}

['dateFrom', 'dateTo', 'category', 'customerType'].forEach(id => {
  document.getElementById(id)?.addEventListener('change', renderWeeklySeriesChart);
});

document.addEventListener('DOMContentLoaded', renderWeeklySeriesChart);
</script>

<script>
const dateFrom = document.getElementById("dateFrom");
const dateTo = document.getElementById("dateTo");
const category = document.getElementById("category");
const customerType = document.getElementById("customerType");
const resetBtn = document.getElementById("reset-filters");

const statsIds = {
  totalFeedback: document.getElementById("total-feedback"),
  avgRating: document.getElementById("avg-rating"),
  satisfactionRate: document.getElementById("satisfaction-rate"),
  avgResponseTime: document.getElementById("avg-response-time")
};

async function updateFilteredContent() {
  const params = new URLSearchParams({
    dateFrom: dateFrom.value,
    dateTo: dateTo.value,
    category: category.value,
    customerType: customerType.value
  });

  try {
    const res = await fetch(`/analytics/filtered-feedback?${params.toString()}`);
    const data = await res.json();

    statsIds.totalFeedback.textContent = data.stats.totalFeedback;
    statsIds.avgRating.textContent = data.stats.avgRating.toFixed(2);
    statsIds.satisfactionRate.textContent = data.stats.satisfactionRate + "%";
    statsIds.avgResponseTime.textContent = data.stats.avgResponseTime;

    const container = document.getElementById("content");
    container.innerHTML = ""; 
    data.feedbacks.forEach(fb => {
      const div = document.createElement("div");
      div.classList.add("feedback-item");
      div.textContent = `${fb.customerName || "-"} - ${fb.customerType} - ${fb.ratingID?.overallExperience || "-"}⭐`;
      container.appendChild(div);
    });

  } catch (err) {
    console.error("Failed to fetch filtered feedback:", err);
  }
}

[dateFrom, dateTo, category, customerType].forEach(el => el.addEventListener("change", updateFilteredContent));
resetBtn.addEventListener("click", () => {
  dateFrom.value = "";
  dateTo.value = "";
  category.value = "";
  customerType.value = "";
  updateFilteredContent();
});

updateFilteredContent();
</script>
<script>
  const path = window.location.pathname.toLowerCase();

  document.querySelectorAll('.menu-item').forEach(item => {
    const href = item.getAttribute('onclick')?.match(/'(.*)'/)?.[1]?.toLowerCase();
    if (href && path === href) {
      item.classList.add('active');
    }
  });
</script>
</body>
