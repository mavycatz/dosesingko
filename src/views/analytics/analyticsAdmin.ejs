<script>
document.addEventListener("DOMContentLoaded", () => {
  const ctx = document.getElementById("month-comparison-chart").getContext("2d");
  let monthChart;

  async function fetchMonthlyData(filters = {}) {
    try {
      const params = new URLSearchParams(filters).toString();
      const res = await fetch(`/analytics/reports/monthly-comparison?${params}`);
      const reportData = await res.json();

      const labels = reportData.labels || [];
      const feedbackData = labels.map(label => reportData.data[label]?.totalFeedback || 0);
      const ratingData = labels.map(label => reportData.data[label]?.avgRating || 0);

      if (monthChart) monthChart.destroy();

      monthChart = new Chart(ctx, {
        type: "bar",
        data: {
          labels,
          datasets: [
            {
              label: "Total Feedback",
              data: feedbackData,
              backgroundColor: "rgba(0,0,0,0.05)",
              borderColor: "rgba(0,0,0,0.3)",
              borderWidth: 1,
              yAxisID: "yFeedback"
            },
            {
              label: "Average Rating",
              data: ratingData,
              type: "line",
              borderColor: "rgba(50,50,50,1)",
              backgroundColor: "rgba(200,200,200,0.2)",
              yAxisID: "yRating",
              tension: 0.3,
              fill: false,
              pointRadius: 5
            }
          ]
        },
        options: {
          responsive: true,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: { position: "bottom", labels: { color: "#111" } },
            tooltip: { mode: "index", intersect: false }
          },
          scales: {
            yFeedback: { type: "linear", position: "left", beginAtZero: true, title: { display: true, text: "Total Feedback", color: "#111" }, ticks: { color: "#111" } },
            yRating: { type: "linear", position: "right", min: 0, max: 5, title: { display: true, text: "Average Rating", color: "#111" }, grid: { drawOnChartArea: false, color: "#eee" }, ticks: { color: "#111" } },
            x: { ticks: { color: "#111" }, grid: { color: "#eee" } }
          }
        }
      });

      const firstValue = labels.length > 1 ? reportData.data[labels[labels.length - 2]] : reportData.data[labels[0]] || { totalFeedback: 0, avgRating: 0 };
      const lastValue = reportData.data[labels[labels.length - 1]] || { totalFeedback: 0, avgRating: 0 };

      let feedbackGrowth;
      if (firstValue.totalFeedback === 0 && lastValue.totalFeedback === 0) {
        feedbackGrowth = "0x";
      } else if (firstValue.totalFeedback === 0 && lastValue.totalFeedback > 0) {
        feedbackGrowth = "∞";
      } else {
        feedbackGrowth = (lastValue.totalFeedback / firstValue.totalFeedback).toFixed(2) + "x";
      }

      const maxRating = 5;
      const ratingImprovement = Math.min(
        lastValue.avgRating - firstValue.avgRating,
        maxRating - firstValue.avgRating
      ).toFixed(2);

      document.getElementById("feedback-growth").textContent = feedbackGrowth;
      document.getElementById("feedback-previous").textContent = firstValue.totalFeedback;
      document.getElementById("feedback-current").textContent = lastValue.totalFeedback;

      document.getElementById("rating-improvement").textContent = ratingImprovement;
      document.getElementById("rating-previous").textContent = firstValue.avgRating.toFixed(2);
      document.getElementById("rating-current").textContent = lastValue.avgRating.toFixed(2);

    } catch (err) {
      console.error("Error fetching monthly comparison data:", err);
    }
  }

  function getFilters() {
    return {
      category: document.getElementById("category")?.value || "",
      customerType: document.getElementById("customerType")?.value || "",
      dateFrom: document.getElementById("dateFrom")?.value || "",
      dateTo: document.getElementById("dateTo")?.value || "",
      filterType: document.getElementById("filterType")?.value || ""
    };
  }

  fetchMonthlyData(getFilters());

  ["category", "customerType", "dateFrom", "dateTo", "filterType"].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener("change", () => fetchMonthlyData(getFilters()));
  });
});
</script>


