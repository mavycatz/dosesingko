  <button class="tab-btn" data-target="statistics"
    style="padding:10px 18px; border:1px solid #ccc; background:#fff; color:#333; border-radius:8px; font-size:14px; font-weight:500; cursor:pointer; transition:all 0.2s ease;">
    Statistics
  </button>
  <button class="tab-btn" data-target="issues"
    style="padding:10px 18px; border:1px solid #ccc; background:#fff; color:#333; border-radius:8px; font-size:14px; font-weight:500; cursor:pointer; transition:all 0.2s ease;">
    Issues
  </button>
</div>

<script>
const tabs = document.querySelectorAll(".tab-btn");
const sections = document.querySelectorAll(".tab-section");

tabs.forEach(tab => {
  tab.addEventListener("click", () => {

    tabs.forEach(t => {
      t.style.background = "#fff";
      t.style.color = "#333";
      t.style.border = "1px solid #ccc";
      t.classList.remove("active");
    });
    tab.style.background = "#000";
    tab.style.color = "#fff";
    tab.style.border = "none";
    tab.classList.add("active");

    const target = tab.dataset.target;
    sections.forEach(sec => {
      if(sec.id === target) sec.style.display = "flex"; 
      else sec.style.display = "none";                 
    });
  });
});

sections.forEach(sec => {
  if(!sec.classList.contains("active")) sec.style.display = "none";
  else sec.style.display = "flex";
});
</script>


<!-- Trends -->
