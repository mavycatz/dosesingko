  <div id="filters" style="padding:15px; border-radius:12px; margin-bottom:20px; font-family:'Poppins', sans-serif; display:flex; flex-direction:column; gap:15px; border:1px solid #ccc;">
    <h1 style="display:flex; align-items:center; font-size:18px; margin:0; color:#000;">
      <i class="fas fa-filter" style="margin-right:8px; font-size:16px; color:#000;"></i>
      Filters & Slicers
    </h1>
    <p style="margin:0; font-size:14px; color:#555;">Filter data across your content</p>
    <div style="display:flex; flex-wrap:wrap; gap:10px; width:100%;">
      <div style="display:flex; gap:5px; flex:2; min-width:200px; flex-wrap:wrap;">
        <input type="date" id="dateFrom" placeholder="From" style="padding:8px 12px; border-radius:8px; border:1px solid #ccc; font-size:14px; flex:1; min-width:100px"/>
        <span style="align-self:center; color:#555;">to</span>
        <input type="date" id="dateTo" placeholder="To" style="padding:8px 12px; border-radius:8px; border:1px solid #ccc; font-size:14px; flex:1; min-width:100px"/>
      </div>
        <select id="category" style="padding:8px 12px; border-radius:8px; border:1px solid #ccc; font-size:14px; flex:1; min-width:120px; width:100%">
          <option value="">All Categories</option>
        </select>
        <select id="customerType" style="padding:8px 12px; border-radius:8px; border:1px solid #ccc; font-size:14px; flex:1; min-width:120px; width:100%">
          <option value="">All Types</option>
        </select>
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; width:100%; margin-top:10px;">
        <p id="infoText" style="margin:0; font-size:14px; color:#555;">Showing Data for: All Categories - All Types - All Dates</p>
          <button id="reset-filters" style="padding:8px 20px; border-radius:8px; border:none; background:#333; color:#fff; font-size:14px; cursor:pointer;">
            Reset Filters
          </button>
      </div>
<script>
const dateFrom = document.getElementById("dateFrom");
const dateTo = document.getElementById("dateTo");
const category = document.getElementById("category");
const customerType = document.getElementById("customerType");
const resetBtn = document.getElementById("reset-filters");
const infoText = document.getElementById("infoText");

function filterContent() {
  const from = dateFrom.value ? new Date(dateFrom.value) : null;
  const to = dateTo.value ? new Date(dateTo.value) : null;
  const cat = category.value;
  const type = customerType.value;

  const items = document.querySelectorAll(".feedback-item");
  items.forEach(item => {
    const itemCat = item.dataset.category || '';
    const itemType = item.dataset.customerType || '';
    const itemDate = item.dataset.date ? new Date(item.dataset.date) : null;

    let show = true;
    if (cat && itemCat !== cat) show = false;
    if (type && itemType !== type) show = false;
    if (from && itemDate && itemDate < from) show = false;
    if (to && itemDate && itemDate > to) show = false;

    item.style.display = show ? "" : "none";
  });

  const catText = cat || "All Categories";
  const typeText = type || "All Types";
  const fromText = dateFrom.value || "Start";
  const toText = dateTo.value || "End";
  infoText.textContent = `Showing Data for: ${catText} - ${typeText} - ${fromText} to ${toText}`;
}

async function loadCategories() {
  try {
    const res = await fetch("/analytics/categories");
    if (!res.ok) throw new Error("Failed to fetch categories");
    const cats = await res.json();
    category.innerHTML = '<option value="">All Categories</option>';
    cats.forEach(c => category.appendChild(new Option(c, c)));
  } catch (err) {
    console.error(err);
  }
}

async function loadCustomerTypes() {
  try {
    const res = await fetch("/analytics/customer-types");
    if (!res.ok) throw new Error("Failed to fetch customer types");

    const types = await res.json();
    const customerType = document.getElementById("customerType");

    customerType.innerHTML = '<option value="">All Types</option>';

    const allowedTypes = ["Dine-In", "Take-Out", "Delivery"];

    const uniqueTypes = [...new Set(types.filter(t => allowedTypes.includes(t)))];

    uniqueTypes.forEach(t => customerType.appendChild(new Option(t, t)));

  } catch (err) {
    console.error(err);
  }
}

[dateFrom, dateTo, category, customerType].forEach(el => el.addEventListener("change", filterContent));
resetBtn.addEventListener("click", () => {
  dateFrom.value = "";
  dateTo.value = "";
  category.value = "";
  customerType.value = "";
  filterContent();
});
async function filterContent() {
  const from = dateFrom.value;
  const to = dateTo.value;
  const cat = category.value;
  const type = customerType.value;

  const catText = cat || "All Categories";
  const typeText = type || "All Types";
  const fromText = from || "Start";
  const toText = to || "End";
  infoText.textContent = `Showing Data for: ${catText} - ${typeText} - ${fromText} to ${toText}`;

  const fromDate = from ? new Date(from) : null;
  const toDate = to ? new Date(to) : null;
  document.querySelectorAll(".feedback-item").forEach(item => {
    const itemCat = item.dataset.category || '';
    const itemType = item.dataset.customerType || '';
    const itemDate = item.dataset.date ? new Date(item.dataset.date) : null;
    let show = true;
    if (cat && itemCat !== cat) show = false;
    if (type && itemType !== type) show = false;
    if (fromDate && itemDate && itemDate < fromDate) show = false;
    if (toDate && itemDate && itemDate > toDate) show = false;
    item.style.display = show ? "" : "none";
  });

  const params = new URLSearchParams();
  if (from) params.append("startDate", from);
  if (to) params.append("endDate", to);
  if (cat) params.append("category", cat);
  if (type) params.append("customerType", type);

  try {
    const res = await fetch(`/analytics/stats?${params.toString()}`);
    if (!res.ok) throw new Error("Failed to fetch stats");
    const data = await res.json();

    document.getElementById("totalFeedback").textContent = data.totalFeedback || 0;
    document.getElementById("avgRating").textContent = data.avgRating?.toFixed(2) || 0;
    document.getElementById("satisfactionRate").textContent = data.satisfactionRate?.toFixed(1) + "%" || "0%";
    document.getElementById("avgResponseTime").textContent = data.avgResponseTime?.toFixed(1) + " mins" || "0 mins";
  } catch (err) {
    console.error(err);
  }
}

loadCategories().then(() => loadCustomerTypes()).then(() => filterContent());
</script>
</div>

