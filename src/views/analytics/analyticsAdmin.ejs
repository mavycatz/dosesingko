<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
let weeklyChart;

async function populateCategories() {
  const select = document.getElementById("category");
  select.innerHTML = '<option value="">All Categories</option>';
  try {
    const categories = await fetch('/analytics/categories').then(r => r.json());
    categories.forEach(c => {
      const option = document.createElement("option");
      option.value = c;
      option.innerText = c;
      select.appendChild(option);
    });
  } catch(err) { console.error(err); }
}

async function populateCustomerTypes() {
  const select = document.getElementById("customerType");
  select.innerHTML = '<option value="">All Customer Types</option>';
  try {
    const types = await fetch('/analytics/customer-types').then(r => r.json());
    types.forEach(t => {
      const option = document.createElement("option");
      option.value = t;
      option.innerText = t;
      select.appendChild(option);
    });
  } catch(err) { console.error(err); }
}

function normalizeCustomerType(type) {
  if (!type) return "";
  const mapping = {
    "Dine-In": "Dine-in",
    "Take-Out": "Take-out",
    "Delivery": "Delivery"
  };
  return mapping[type] || type;
}

async function renderWeeklyFeedbackChart(filters = {}) {
  try {
    const cleanedFilters = {};
    Object.keys(filters).forEach(k => {
      if (filters[k] && filters[k] !== "") cleanedFilters[k] = filters[k];
    });

    if (cleanedFilters.customerType) {
      cleanedFilters.customerType = normalizeCustomerType(cleanedFilters.customerType);
    }

    const params = new URLSearchParams(cleanedFilters);
    const response = await fetch(`/analytics/weekly-trends?${params.toString()}`);
    const data = await response.json();

    const ctx = document.getElementById("feedback-trends-chart").getContext("2d");

    const labels = data.labels || [];
    const negativeRatings = data.negativeRatings || [];
    const positiveRatings = data.positiveRatings || [];
    const avgRatings = data.avgRatings || [];
    const totalFeedback = data.totalFeedback || [];
    const predictedFlags = data.predictedFlags || []; 

    const cappedNegativeRatings = negativeRatings.map(v => v > 5 ? 5 : v);
    const cappedPositiveRatings = positiveRatings.map(v => v > 5 ? 5 : v);
    const cappedAvgRatings = avgRatings.map(v => v > 5 ? 5 : v);

    const chartData = {
      labels,
      datasets: [
        {
          label: "Negative",
          data: cappedNegativeRatings,
          type: "line",
          borderColor: "#555",
          backgroundColor: cappedNegativeRatings.map((_, i) => predictedFlags[i] ? "rgba(0,0,0,0.15)" : "rgba(0,0,0,0.3)"),
          tension: 0.3,
          pointRadius: 6,
          pointStyle: cappedNegativeRatings.map((_, i) => predictedFlags[i] ? 'circle' : 'circle'),
          pointBackgroundColor: cappedNegativeRatings.map((_, i) => predictedFlags[i] ? "#fff" : "#555"),
          pointBorderColor: "#555"
        },
          {
          label: "Positive",
          data: cappedPositiveRatings,
          type: "line",
          borderColor: "#000", 
          borderWidth: 2,
          tension: 0.3,
          pointRadius: 6,
          pointStyle: cappedPositiveRatings.map((_, i) => predictedFlags[i] ? 'circle' : 'circle'), 
          pointBackgroundColor: cappedPositiveRatings.map((_, i) => predictedFlags[i] ? "rgba(0,0,0,0.1)" : "#000"), 
          pointBorderColor: cappedPositiveRatings.map((_, i) => predictedFlags[i] ? "rgba(0,0,0,0.3)" : "#000"), 
        },
        {
          label: "Avg Rating",
          data: cappedAvgRatings,
          type: "line",
          borderColor: "#999",
          borderWidth: 2,
          tension: 0.3,
          pointRadius: 6,
          borderDash: predictedFlags.map(f => f ? [5,5] : []),
          pointStyle: predictedFlags.map(f => f ? 'rectRot' : 'circle'),
          pointBackgroundColor: predictedFlags.map(f => f ? "#fff" : "#999"),
          pointBorderColor: "#999"
        },
        {
          label: "Total Feedback",
          data: totalFeedback,
          type: "bar",
          backgroundColor: totalFeedback.map((_, i) => predictedFlags[i] ? "rgba(200,200,200,0.4)" : "#ccc"),
          borderColor: "#999",
          borderWidth: 1,
          yAxisID: "y1"
        }
      ]
    };

    const chartOptions = {
      responsive: true,
      interaction: { mode: "nearest", intersect: true },
      stacked: false,
      onClick: (evt, elements) => {
        if (!elements.length) return;
        const weekIndex = elements[0].index;

        weeklyChart.data.datasets.forEach(ds => {
          ds.pointRadius = ds.data.map((_, i) => i === weekIndex ? 8 : 6);
        });
        weeklyChart.update();

        const avg = avgRatings[weekIndex] || 0;
        const pos = positiveRatings[weekIndex] || 0;
        const neg = negativeRatings[weekIndex] || 0;
        const total = totalFeedback[weekIndex] || 0;

        document.getElementById('weekly-summary-content').innerHTML = `
          <strong>${labels[weekIndex]}</strong>
          <ul>
            <li>Average Rating: ${avg.toFixed(2)}</li>
            <li>Positive Feedback: ${pos}</li>
            <li>Negative Feedback: ${neg}</li>
            <li>Total Feedback: ${total}</li>
          </ul>
        `;

        let insightsHTML = `<strong>Key Insights:</strong><br>`;
        if (avg >= 4) insightsHTML += `• Ratings are high. Maintain what you're doing!<br>`;
        else insightsHTML += `• Ratings are moderate or low. Consider improvements.<br>`;

        insightsHTML += `<strong>Recommendations / Conclusion:</strong><br>`;
        if (avg < 4) insightsHTML += `• Address areas affecting ratings.<br>`;
        insightsHTML += `• Encourage satisfied customers to promote your service.<br>• Monitor weekly trends.`;

        document.getElementById('weekly-summary-insights').innerHTML = insightsHTML;
      },
      scales: {
        y: {
          min: 0,
          max: 5,
          title: { display: true, text: "Rating", color: "#000", font: { weight: "bold" } },
          grid: { color: "#eee" },
          ticks: { color: "#333" }
        },
        y1: {
          min: 0,
          max: Math.max(...totalFeedback, 5) * 1.1,
          position: "right",
          title: { display: true, text: "Total Feedback", color: "#000", font: { weight: "bold" } },
          grid: { drawOnChartArea: false },
          ticks: { color: "#333" }
        },
        x: { ticks: { color: "#000" }, grid: { color: "#f2f2f2" } }
      },
      plugins: {
        legend: { display: true },
        tooltip: { backgroundColor: "#fff", titleColor: "#000", bodyColor: "#000", borderColor: "#ccc", borderWidth: 1 }
      }
    };

    if (weeklyChart) weeklyChart.destroy();
    weeklyChart = new Chart(ctx, { type: "bar", data: chartData, options: chartOptions });

  } catch(err) {
    console.error("Error rendering chart:", err);
  }
}

