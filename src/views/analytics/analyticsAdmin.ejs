  <button class="tab-btn" data-target="reports"
    style="padding:10px 18px; border:1px solid #ccc; background:#fff; color:#333; border-radius:8px; font-size:14px; font-weight:500; cursor:pointer; transition:all 0.2s ease;">
    Reports
