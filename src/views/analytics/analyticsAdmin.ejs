    <div style="display:flex; flex-direction:column;">
      <span style="font-size:12px; color:#555; font-weight:500;">Avg Response Time</span>
      <div style="display:flex; align-items:center; margin-top:6px;">
        <span id="avg-response-time" style="font-size:24px; font-weight:700; margin-right:6px;">3.2 min</span>
        <i class="fas fa-arrow-down" style="color:red; font-size:16px;"></i>
      </div>
    </div>
    <i class="fas fa-clock" style="font-size:36px; color:#000;"></i>
  </div>
</div>

<script>
async function updateStatsCards() {
  try {
    const params = new URLSearchParams();
    if (dateFrom.value) params.append("dateFrom", dateFrom.value);
    if (dateTo.value) params.append("dateTo", dateTo.value);
    if (category.value) params.append("category", category.value);
    if (customerType.value) params.append("customerType", customerType.value);

    const res = await fetch(`/analytics/stats?${params.toString()}`);
    const data = await res.json();

    document.getElementById("total-feedback").textContent = Number(data.totalFeedback).toLocaleString();
    document.getElementById("avg-rating").textContent = Number(data.avgRating).toFixed(2);
    document.getElementById("satisfaction-rate").textContent = Number(data.satisfactionRate).toFixed(2) + "%";
    document.getElementById("avg-response-time").textContent = Number(data.avgResponseTime).toFixed(2) + " min";

  } catch (err) {
    console.error("Failed to update stats cards:", err);
  }
}
[dateFrom, dateTo, category, customerType].forEach(el => {
  el.addEventListener("change", () => {
    filterContent();      
    updateStatsCards(); 
  });
});

resetBtn.addEventListener("click", () => {
  dateFrom.value = "";
  dateTo.value = "";
  category.value = "";
  customerType.value = "";
  filterContent();
  updateStatsCards();
});

document.addEventListener("DOMContentLoaded", () => {
  loadCategories().then(() => loadCustomerTypes()).then(() => {
    filterContent();
    updateStatsCards();
  });
});
</script>

<!-- Section Tabs -->
<div id="section-tabs" style="display:flex; gap:10px; border-bottom:1px solid #ccc; padding:10px 0; font-family:'Poppins', sans-serif;">
  <button class="tab-btn active" data-target="trends"
    style="padding:10px 18px; border:none; background:#000; color:#fff; border-radius:8px; font-size:14px; font-weight:500; cursor:pointer; transition:all 0.2s ease;">
    Trends
