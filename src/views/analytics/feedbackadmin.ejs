<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Prevent default form submission
  document.getElementById('bulkDeleteForm').addEventListener('submit', e => e.preventDefault());

  document.getElementById('bulkDeleteBtn').addEventListener('click', async function(e) {
    try {
      // collect selected feedback IDs
      const ids = Array.from(document.querySelectorAll('.feedback-checkbox:checked'))
                        .map(cb => cb.value);

      if (ids.length === 0) {
        return Swal.fire({
          title: 'No selection',
          text: 'Please select at least one feedback to delete.',
          icon: 'warning',
          confirmButtonColor: '#000000',
        });
      }

      // confirm deletion
      const result = await Swal.fire({
        title: 'Delete selected feedbacks?',
        text: 'This action cannot be undone.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#000000',
        cancelButtonColor: '#888888',
        confirmButtonText: 'Yes, delete',
        cancelButtonText: 'Cancel'
      });

      if (result.isConfirmed) {
        // call your AJAX function
        const response = await fetch('/feedback/delete-multiple', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            title: 'Deleted!',
            text: data.message,
            icon: 'success',
            confirmButtonColor: '#000000'
          });

          // remove deleted rows from table dynamically
          ids.forEach(id => {
            const row = document.querySelector(`.feedback-checkbox[value="${id}"]`).closest('tr');
            if (row) row.remove();
          });
        } else {
          Swal.fire({
            title: 'Error',
            text: data.message,
            icon: 'error',
            confirmButtonColor: '#000000'
          });
        }
      }

    } catch (err) {
      Swal.fire({
        title: 'Error',
        text: 'An unexpected error occurred.',
        icon: 'error',
        confirmButtonColor: '#000000',
      });
      console.error(err);
    }
  });

  // select all checkbox
  document.getElementById('selectAll').addEventListener('change', function() {
    document.querySelectorAll('.feedback-checkbox').forEach(cb => cb.checked = this.checked);
  });
</script>

