<script>
const showMessage = (message, success = true) => {
  const msgBox = document.getElementById("approvalMessage");
  msgBox.style.display = "block";
  msgBox.style.width = "700px";
  msgBox.textContent = message;
  msgBox.style.backgroundColor = success ? "#8fd19e" : "#F28B82";
  setTimeout(() => { msgBox.style.display = "none"; }, 3000);
};

// Approve/unapprove feedback
document.querySelectorAll(".approve-btn").forEach(button => {
  button.addEventListener("click", async () => {
    const feedbackId = button.dataset.id;
    try {
      const res = await fetch(`/feedback/approve/${feedbackId}`, {
        method: "POST",
        credentials: "same-origin"
      });
      if (!res.ok) throw new Error(await res.text());
      const data = await res.json();
      showMessage(data.message, data.success);

      const icon = button.querySelector("i");
      if (data.approved) {
        icon.classList.remove("bi-check-circle");
        icon.classList.add("bi-check-circle-fill");
      } else {
        icon.classList.remove("bi-check-circle-fill");
        icon.classList.add("bi-check-circle");
      }
    } catch (err) {
      console.error(err);
      showMessage(err.message || "An error occurred", false);
    }
  });
});
document.querySelectorAll("form[action^='/feedback/delete/']").forEach(form => {
  form.addEventListener("submit", async e => {
    e.preventDefault();

    const feedbackId = form.action.split("/").pop();

    const result = await Swal.fire({
      title: 'Delete this feedback?',
      text: "This action cannot be undone.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#888',
      confirmButtonText: 'Yes, delete it!',
      cancelButtonText: 'Cancel'
    });

    if (!result.isConfirmed) return;

    try {
      const res = await fetch(`/feedback/delete/${feedbackId}`, {
        method: "POST",
        credentials: "same-origin"
      });

      if (!res.ok) throw new Error(await res.text());

      const data = await res.json();

      Swal.fire({
        title: data.success ? 'Deleted!' : 'Error',
        text: data.message,
        icon: data.success ? 'success' : 'error',
        confirmButtonColor: '#000'
      });

      if (data.success) {
        const row = form.closest("tr");
        if (row) row.remove();
      }

    } catch (err) {
      console.error(err);
      Swal.fire({
        title: 'Error',
        text: err.message || 'An unexpected error occurred',
        icon: 'error',
        confirmButtonColor: '#000'
      });
    }
  });
});
// AI Reply (updated to show floating message instead of alert)
document.querySelectorAll(".auto-reply-btn").forEach(button => {
  button.addEventListener("click", async () => {
    const feedbackId = button.dataset.id;
    try {
      const res = await fetch(`/ai-reply/${feedbackId}`, {
        method: "GET",
        credentials: "same-origin"
      });
      if (!res.ok) throw new Error(await res.text());
      const data = await res.json();

      if (data.success) {
        showMessage(`AI Reply Sent: ${data.suggestedReply}`);
      } else {
        showMessage(data.message || "Failed to generate AI reply", false);
      }
    } catch (err) {
      console.error(err);
      showMessage(err.message || "An error occurred", false);
    }
  });
});

document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".delete-reply-form").forEach(form => {
    form.addEventListener("submit", async e => {
      e.preventDefault();

      const result = await Swal.fire({
        title: 'Delete this reply?',
        text: "This action cannot be undone.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#888',
        confirmButtonText: 'Yes, delete it!',
        cancelButtonText: 'Cancel'
      });

      if (!result.isConfirmed) return;

      const parts = form.action.split("/");
      const feedbackId = parts[parts.length - 2];
      const replyId = parts[parts.length - 1];

      try {
        const res = await fetch(`/feedback/reply/delete/${feedbackId}/${replyId}`, {
          method: "POST",
          credentials: "same-origin"
        });
        if (!res.ok) throw new Error(await res.text());
        const data = await res.json();

        showMessage(data.message, data.success);

        if (data.success) {
          // safely remove the reply container
          const replyContainer = form.closest(".reply-item") || form.parentElement;
          if (replyContainer) replyContainer.remove();
        }
      } catch (err) {
        console.error(err);
        showMessage(err.message || "An error occurred", false);
      }
    });
  });
});


// Edit reply
document.addEventListener("submit", async e => {
  if (!e.target.matches(".edit-reply-form")) return;
  e.preventDefault();

  const form = e.target;
  const feedbackId = form.dataset.feedbackId;
  const replyId = form.dataset.replyId;
  const replyInput = form.querySelector("textarea").value.trim();
  if (!replyInput) return;

  try {
    const res = await fetch(`/feedback/reply/edit/${feedbackId}/${replyId}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ replyMessage: replyInput }),
      credentials: "same-origin"
    });
    if (!res.ok) throw new Error(await res.text());
    const data = await res.json();
    showMessage(data.message, data.success);

    if (data.success) {
      const replyTextElem = document.querySelector(
        `button[data-bs-target="#editReplyModal${replyId}"]`
      )?.closest(".d-flex.align-items-start")?.querySelector(".reply-text");

      if (replyTextElem) replyTextElem.textContent = replyInput;

      const modalEl = document.getElementById(`editReplyModal${replyId}`);
      const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
      modal.hide();
    }
  } catch (err) {
    console.error(err);
    showMessage(err.message || "An error occurred", false);
  }
});
</script>


<script>
  const path = window.location.pathname.toLowerCase();

  document.querySelectorAll('.menu-item').forEach(item => {
    const href = item.getAttribute('onclick')?.match(/'(.*)'/)?.[1]?.toLowerCase();
    if (href && path === href) {
      item.classList.add('active');
    }
  });
</script>

