<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>
    <%= report.title %>
  </title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
      color: #000;
      background: #fff;
    }

    h1 {
      text-align: center;
      color: #000;
      margin-bottom: 10px;
    }

    h2 {
      margin-top: 30px;
      color: #000;
    }

    p {
      margin: 5px 0;
      font-size: 14px;
    }

    strong {
      font-weight: bold;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      font-size: 12px;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 6px;
      text-align: center;
    }

    th {
      background-color: #000;
      color: #fff;
    }

    .summary {
      border: 1px solid #000;
      padding: 10px;
      margin-bottom: 20px;
    }

    .chart-container {
      width: 90%;
      max-width: 900px;
      margin: 20px auto;
    }
  </style>
</head>

<body>

  <h1>
    <%= report.title %>
  </h1>

  <div class="summary">
    <p><strong>Status:</strong>
      <%= report.status %>
    </p>
    <p><strong>Description:</strong>
      <%= report.description %>
    </p>
    <p><strong>Date Range:</strong>
      <%= report.dateRange %>
    </p>
    <p><strong>Key Finding:</strong>
      <%= report.keyFinding %>
    </p>
  </div>

  <% if(report.trendData && report.trendData.labels.length) { %>
    <h2>Service Rating Trend</h2>
    <div class="chart-container">
      <canvas id="serviceChart"></canvas>
    </div>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Service Rating</th>
        </tr>
      </thead>
      <tbody>
        <% for(let i=0; i < report.trendData.labels.length; i++) { %>
          <tr>
            <td>
              <%= report.trendData.labels[i] %>
            </td>
            <td>
              <%= report.trendData.values[i] %>
            </td>
          </tr>
          <% } %>
      </tbody>
    </table>
    <% } %>

      <% if(report.feedbacks && report.feedbacks.length) { %>
        <h2>Detailed Feedbacks</h2>
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Customer</th>
              <th>OR Number</th>
              <th>Service</th>
              <th>Food</th>
              <th>Ambiance</th>
              <th>Value</th>
              <th>Staff</th>
              <th>Bartender</th>
              <th>Issue?</th>
            </tr>
          </thead>
          <tbody>
            <% report.feedbacks.forEach(f=> { %>
              <tr>
                <td>
                  <%= new Date(f.createdAt).toLocaleDateString() %>
                </td>
                <td>
                  <%= f.customerName || "Anonymous" %>
                </td>
                <td>
                  <%= f.orNumber || "-" %>
                </td>
                <td>
                  <%= f.ratingID?.service ?? "-" %>
                </td>
                <td>
                  <%= f.ratingID?.foodQuality ?? "-" %>
                </td>
                <td>
                  <%= f.ratingID?.ambiance ?? "-" %>
                </td>
                <td>
                  <%= f.ratingID?.valueForMoney ?? "-" %>
                </td>
                <td>
                  <%= f.ratingID?.staffAttitude ?? "-" %>
                </td>
                <td>
                  <%= f.ratingID?.bartenderAttitude ?? "-" %>
                </td>
                <td>
                  <%= f.ratingID?.service < 3 ? "Yes" : "No" %>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
        <% } %>

          <script>
    <% if (report.trendData && report.trendData.labels.length) { %>
      const ctx = document.getElementById('serviceChart').getContext('2d');
              new Chart(ctx, {
                type: 'bar',
                data: {
                  labels: <% - JSON.stringify(report.trendData.labels) %>,
                  datasets: [{
                    label: 'Service Rating',
                    data: <% - JSON.stringify(report.trendData.values) %>,
                    backgroundColor: <% - JSON.stringify(report.trendData.values.map(v => v < 3 ? 'rgba(200,0,0,0.7)' : 'rgba(0,0,0,0.7)')) %>,
                    borderColor: '#000',
                    borderWidth: 1
                  }]
                },
                options: {
                  responsive: true,
                  plugins: {
                    legend: { display: false },
                    title: { display: true, text: 'Service Ratings Over Time', color: '#000', font: { size: 16 } }
                  },
                  scales: {
                    y: { beginAtZero: true, max: 5, title: { display: true, text: 'Rating (1-5)', color: '#000' } },
                    x: { title: { display: true, text: 'Date', color: '#000' } }
                  }
                }
              });
    <% } %>
          </script>

</body>

</html>