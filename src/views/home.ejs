  <!-- ✅ JS -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const storyText = document.querySelector(".story-text");
      const storyPhoto = document.querySelector(".story-photo-box");

      // IntersectionObserver para sa scroll effect
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (entry.target.classList.contains("story-text")) {
              entry.target.classList.add("show", "fade-left");
            } else if (entry.target.classList.contains("story-photo-box")) {
              entry.target.classList.add("show", "fade-right");
            }
          } else {
            // kapag wala na sa view, alisin ulit para mag-reset
            entry.target.classList.remove("show", "fade-left", "fade-right");
          }
        });
      }, { threshold: 0.2 });

      observer.observe(storyText);
      observer.observe(storyPhoto);

      // ✅ Pag pinindot yung "About" sa navbar
      const aboutLink = document.querySelector('a[href="#about"]');
      const aboutSection = document.querySelector(".story-section");

      if (aboutLink && aboutSection) {
        aboutLink.addEventListener("click", (e) => {
          e.preventDefault();
          aboutSection.scrollIntoView({ behavior: "smooth" });

          // force show effect after scroll
          setTimeout(() => {
            storyText.classList.add("show", "fade-left");
            storyPhoto.classList.add("show", "fade-right");
          }, 400);
        });
      }
    });
  </script>
