      event.target.classList.add('active');
    }

    function toggleSeeMore(btn) {
      const grid = btn.previousElementSibling;
      grid.classList.toggle('collapsed');
      btn.textContent = grid.classList.contains('collapsed') ? "See More" : "See Less";
    }
