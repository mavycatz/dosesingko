  <script>
    const texts = [
      "Welcome to Dose Singko Café",
      "Enjoy our freshly brewed coffee",
      "Share your experience with us"
    ];

    let textIndex = 0;
    let charIndex = 0;
    let currentText = "";
    let isDeleting = false;

    function typeWriter() {
      currentText = texts[textIndex];

      if (!isDeleting) {
        document.getElementById("hero-title").innerHTML =
          currentText.substring(0, charIndex + 1) + "<span class='cursor'>|</span>";
        charIndex++;

        if (charIndex === currentText.length) {
          isDeleting = true;
          setTimeout(typeWriter, 1500);
          return;
        }
      } else {
        document.getElementById("hero-title").innerHTML =
          currentText.substring(0, charIndex - 1) + "<span class='cursor'>|</span>";
        charIndex--;

        if (charIndex === 0) {
          isDeleting = false;
          textIndex = (textIndex + 1) % texts.length;
        }
      }

      setTimeout(typeWriter, isDeleting ? 70 : 100);
    }

    window.onload = typeWriter;

    // ✅ Function to replay animation
    function replayEntrance() {
      const heroElements = document.querySelectorAll(".hero-text, .hero-logo");
      heroElements.forEach(el => {
        el.classList.remove("grand-entrance");
        void el.offsetWidth; // reflow
        el.classList.add("grand-entrance");
      });
    }

    // ✅ Replay entrance when clicking "Home"
    document.querySelectorAll('a[href="#home"]').forEach(link => {
      link.addEventListener("click", () => {
        replayEntrance();
      });
    });

    // ✅ Replay entrance when Hero is visible on scroll
    const heroSection = document.querySelector("#home");
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          replayEntrance();
        }
      });
    }, { threshold: 0.4 }); // trigger when 40% visible

    observer.observe(heroSection);
  </script>

