  <script>
    const carousel = document.querySelector('.why-carousel');
    const cards = document.querySelectorAll('.why-carousel .card');
    const cardWidth = cards[0].offsetWidth + 40; // card + gap
    let position = 0;

    function animateCarousel() {
      position -= 0.9; // speed
      carousel.style.transform = `translateX(${position}px)`;

      // reset loop
      if (Math.abs(position) >= cardWidth * (cards.length / 2)) {
        position = 0;
      }

      // highlight center card
      const wrapperCenter = carousel.parentElement.offsetWidth / 2;
      cards.forEach(card => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        if (Math.abs(wrapperCenter - cardCenter) < rect.width / 2) {
          card.classList.add('active');
        } else {
