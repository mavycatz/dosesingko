  <script>
    const images = [
      '/images/dosesingkohero1.png',
      '/images/dosesingkohero2.png',
      '/images/dosesingkohero4.png',
      '/images/dosesingkohero3.png',
      '/images/dosesingkohero5.jpg',
      '/images/dosehero2.jpg',
      '/images/dosehero3.jpg',
      '/images/dosehero5.jpg'
    ];

    const texts = [
      "Cozy Ambiance, Perfect Coffee",
      "Taste the Best Pastries in Town",
      "Relax and Enjoy Your Time",
      "Freshly Brewed, Every Day",
      "A Place for Conversations",
      "Quality Service You Deserve",
      "Savor Every Bite",
      "Your Comfort, Our Priority"
    ];

    const slides = document.querySelectorAll('#hero-slideshow .slide');
    const subtitle = document.getElementById('hero-subtitle');
    const bokehOverlay = document.getElementById('bokeh-overlay');
    const cursor = document.getElementById('cursor-light');
    const heroSection = document.querySelector('.hero');

    let currentSlideDiv = 0;
    let currentImageIndex = 0;

    // Initialize first slide
    slides[0].style.background = `url('${images[0]}') center/cover no-repeat`;
    slides[0].style.filter = 'blur(8px)';
    subtitle.textContent = texts[0];

    // Slideshow function
    function showSlide() {
      const nextImageIndex = (currentImageIndex + 1) % images.length;
      const fadeInDiv = slides[1 - currentSlideDiv];
      const fadeOutDiv = slides[currentSlideDiv];

      fadeInDiv.style.background = `url('${images[nextImageIndex]}') center/cover no-repeat`;
      fadeInDiv.style.filter = 'blur(8px)';
      fadeInDiv.style.opacity = 1;
      fadeInDiv.style.transform = 'scale(1.05)';

      fadeOutDiv.style.opacity = 0;
      fadeOutDiv.style.transform = 'scale(1.05)';

      bokehOverlay.style.opacity = 0.4;

      subtitle.style.opacity = 0;
      setTimeout(() => {
        subtitle.textContent = texts[nextImageIndex];
        subtitle.style.transition = 'opacity 1s ease-in-out';
        subtitle.style.opacity = 1;
      }, 300);

      currentSlideDiv = 1 - currentSlideDiv;
      currentImageIndex = nextImageIndex;
    }

    setInterval(showSlide, 5000);

    // Cursor initially hidden
    cursor.style.opacity = 0;

    heroSection.addEventListener('mouseenter', () => { cursor.style.opacity = 1; });
    heroSection.addEventListener('mouseleave', () => {
      cursor.style.opacity = 0;
      slides.forEach(slide => slide.style.backgroundPosition = 'center');
    });

    // Cursor and image follow
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const percentX = (e.clientX - rect.left) / rect.width - 0.5;
      const percentY = (e.clientY - rect.top) / rect.height - 0.5;

      slides.forEach((slide, index) => {
        const depth = (index + 1) / slides.length;
        const moveX = percentX * 20 * depth; // px movement
        const moveY = percentY * 20 * depth;
        slide.style.backgroundPosition = `calc(50% + ${moveX}px) calc(50% + ${moveY}px)`;
      });

      cursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    });
  </script>



