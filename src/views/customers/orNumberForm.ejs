<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Enter OR Number</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="shortcut icon" href="/images/iconup.png" type="image/png">

<style>
body {
  margin: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Poppins', sans-serif;
  position: relative;
  overflow: hidden;
}

body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: url('/images/story2.png') no-repeat center center/cover;
  filter: blur(8px);
  z-index: -2;
}

body::after {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.5;
  z-index: -1;
}


.container-box {
  position: relative;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 20px;
  padding: 4rem 2rem 2rem;
  width: 100%;
  max-width: 420px;
  text-align: center;
  box-shadow: 0 12px 35px rgba(0,0,0,0.12);
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
  margin: auto;
  backdrop-filter: blur(10px);
}

  .container-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.18);
  }


  .coffee-deco {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 6rem;
    color: #111;
    opacity: 0.12;
    text-shadow: 0 4px 10px rgba(0,0,0,0.1);
    animation: floatCoffee 3s ease-in-out infinite;
  }

  @keyframes floatCoffee {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50% { transform: translate(-50%, -50%) translateY(-8px); }
  }

  h2 {
    font-size: 2rem;
    font-weight: 800;
    color: #111;
    margin-bottom: 0.5rem;
  }

  p.description {
    font-size: 0.95rem;
    font-weight: 400;
    color: #555;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .feedback-prompt {
    font-size: 0.9rem;
    font-weight: 500;
    color: #222;
    margin-bottom: 2rem;
  }

  .feedback-prompt i {
    font-size: 1.3rem;
    margin: 0 4px;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2) rotate(-5deg); }
  }

  label {
    display: block;
    font-weight: 600;
    text-align: left;
    font-size: 0.9rem;
    margin-bottom: 0.3rem;
    color: #222;
  }

  input[type="text"] {
    width: 100%;
    padding: 0.85rem 1rem;
    border: none;
    border-bottom: 2px solid #ccc;
    font-size: 0.95rem;
    color: #111;
    background: transparent;
    font-family: 'Poppins', sans-serif;
    transition: all 0.3s ease;
  }

  input[type="text"]:focus {
    outline: none;
    border-bottom: 2px solid #111;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  }

  button {
    width: 100%;
    margin-top: 1rem;
    background: #111;
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 0.85rem;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Poppins', sans-serif;
  }

  button:hover {
    background: #222;
    transform: scale(1.05) translateY(-2px);
  }

  #errorMsg {
    font-size: 0.8rem;
    background-color: #222;
    color: #eee;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 10px;
    margin-bottom: 1rem;
    opacity: 1;
    transition: opacity 0.5s, transform 0.5s;
    font-family: 'Poppins', sans-serif;
  }

  @media (max-width: 576px) {
    .container-box { padding: 3.5rem 1.5rem 2rem; max-width: 90%; }
    h2 { font-size: 1.6rem; }
    .feedback-prompt { font-size: 0.85rem; }
    .coffee-deco { font-size: 4.5rem; }
  }
</style>
</head>
<body>
<a href="/" style="display: inline-flex; align-items: center; text-decoration: none; color: black; font-size: 0.9rem; font-weight: normal; position: absolute; top: 20px; left: 30px;">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 5px;">
    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 1-.5.5H2.707l5.147 5.146a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708.708L2.707 7.5H14.5A.5.5 0 0 1 15 8z"/>
  </svg>
  Back to Home
</a>


<div class="container-box">
  <i class="bi bi-cup-fill coffee-deco"></i>

  <h2>Enter Your OR Number</h2>
  <p class="description">Please input your official receipt number to proceed.</p>

<p class="feedback-prompt">
  Enjoyed your <i class="bi bi-cup-fill"></i> coffee and 
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi" viewBox="0 0 16 16" style="vertical-align:middle;">
    <path d="M8 0C6 0 4 1 4 3s2 3 4 3 4-1 4-3-2-3-4-3z"/>
    <path d="M0 8h16v2H0V8zm0 3h16v3H0v-3z"/>
  </svg> dessert? Share your thoughts by writing a feedback!
</p>


  <% if (error) { %>
  <div id="errorMsg">
    <i class="bi bi-exclamation-triangle-fill me-1"></i>
    <span><%= error %></span>
  </div>
  <script>
    setTimeout(() => {
      const msg = document.getElementById('errorMsg');
      if (msg) {
        msg.style.opacity = '0';
        msg.style.transform = 'translateY(-10px)';
        setTimeout(() => msg.remove(), 500);
      }
    }, 3000);
  </script>
  <% } %>

  <form action="/customers/or-number" method="POST">
    <div class="mb-4 text-start">
      <label for="orNumber">OR Number</label>
      <input type="text" id="orNumber" name="orNumber" placeholder="e.g., 123456" required>
    </div>
    <button type="submit">Proceed</button>
  </form>
</div>

</body>
</html>
