    <li><a href="/dose-singko" style="text-decoration: none; color: gray;">Dose Singko</a></li>
    <li><a href="/menu" style="text-decoration: none; color: gray;">Menu</a></li>
    <li><a href="/contacts" style="text-decoration: none; color: gray;">Contacts</a></li>
    <li><a href="/locations" style="text-decoration: none; color: gray;">Find Locations</a></li>
    <li><a href="/branches" style="text-decoration: none; color: gray;">Branches</a></li>
  </ul>
</div>

  <div class="mx-auto" style="background-color: #ffffff; border-radius: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); padding: 20px; max-width: 300px; max-height: 400px; margin-top: 10px;">
  <h2 style="font-size: 1.2rem; color: black; margin-bottom: 0.8rem;">Recent Reviews</h2>
  <% feedbacks.slice(0, 3).forEach(fb => { %>
    <p style="margin: 0 0 0.2rem 0; line-height: 1rem;">
      <% for(let i = 1; i <= 5; i++) { %>
        <% if(i <= fb.ratingID.overallExperience) { %>
          <span style="color: black; font-size: 1rem;">&#9733;</span>
        <% } else { %>
          <span style="color: #ccc; font-size: 1rem;">&#9733;</span>
        <% } %>
      <% } %>
    </p>
    <p style="font-style: italic; color: #555; margin: 0 0 0.2rem 0; line-height: 1.1rem;">"<%= fb.message %>"</p>
    <p style="font-weight: normal; color: #888; margin: 0 0 0.5rem 0; line-height: .8rem;">- 
      <%= fb.customerName || (() => {
        let letters = 'abcdefghijklmnopqrstuvwxyz';
        let firstName = letters[Math.floor(Math.random() * letters.length)].toUpperCase() + '*******';
        let lastName = letters[Math.floor(Math.random() * letters.length)].toUpperCase() + '.';
        return `${firstName} ${lastName}`;
      })() %>
    </p>
  <% }) %>
</div>

  </div>
</div>

<script>
document.querySelectorAll('.stars').forEach(starContainer => {
  const inputName = starContainer.dataset.inputName;
  const hiddenInput = starContainer.parentElement.querySelector(`input[name="${inputName}"]`);
  
  for (let i = 1; i <= 5; i++) {
    const star = document.createElement('span');
    star.textContent = '★';
    star.style.cursor = 'pointer';
    star.dataset.value = i;

    star.addEventListener('click', () => {
      starContainer.querySelectorAll('span').forEach(s => s.classList.remove('selected'));
      for (let j = 0; j < i; j++) {
        starContainer.querySelectorAll('span')[j].classList.add('selected');
      }
      hiddenInput.value = i;
    });

    starContainer.appendChild(star);
  }
});
</script>

  </form>
<% if (success) { %>
  <div id="successMessage" style="
      position: fixed;
      top: 1rem;
      left: 50%;
      transform: translateX(-50%);
      background-color: #28a745;
      color: white;
      padding: 0.5rem 1rem;
      border-radius: 50px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
      z-index: 9999;
      font-size: 0.9rem;
    ">
    <%= success %>
  </div>

  <script>
    setTimeout(() => {
      const msg = document.getElementById('successMessage');
      if (msg) msg.style.display = 'none';
    }, 5000);
  </script>
<% } %>


<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
