    <form action="/feedback" method="POST">

<h2 class="fw-normal text-black" style="font-size: 1rem;">Share your Experience</h2>
<h1 class="fw-normal text-secondary" style="font-size: 1rem;">Your feedback helps us continuously improve our service, food quality, and overall experience.</h1>

          <div class="rating-group mb-3">
        <label class="d-block">Overall Experience:</label>
        <small class="text-muted d-block mb-1">e.g., Is Everything Good? Great Service? Fast Transaction?</small>
        <div class="stars mt-1" data-input-name="overallExperience"></div>
        <input type="hidden" name="overallExperience" value="0">
        <textarea name="overallExperienceReason" placeholder="Reason (optional)" class="form-control mt-1 simple-textarea"></textarea>
      </div>

      <h3 class="mt-3" style="font-size: 1rem; color: black; font-weight: normal;">Rate your Experience</h3>
      <div class="row">
        <div class="col-md-6">
          <div class="rating-group mb-3">
            <label class="d-block">Food Quality:</label>
            <small class="text-muted d-block mb-1">e.g., Taste, Presentation, Freshness</small>
            <div class="stars mt-1" data-input-name="foodQuality"></div>
            <input type="hidden" name="foodQuality" value="0">
            <textarea name="foodQualityReason" placeholder="Reason (optional)" class="form-control mt-1 simple-textarea"></textarea>
          </div>

          <div class="rating-group mb-3">
            <label class="d-block">Ambiance:</label>
            <small class="text-muted d-block mb-1">e.g., Clean, Comfortable, Pleasant</small>
            <div class="stars mt-1" data-input-name="ambiance"></div>
            <input type="hidden" name="ambiance" value="0">
            <textarea name="ambianceReason" placeholder="Reason (optional)" class="form-control mt-1 simple-textarea"></textarea>
          </div>

          <div class="rating-group mb-3">
            <label class="d-block">Service:</label>
            <small class="text-muted d-block mb-1">e.g., Friendly, Fast, Attentive</small>
            <div class="stars mt-1" data-input-name="service"></div>
            <input type="hidden" name="service" value="0">
            <textarea name="serviceReason" placeholder="Reason (optional)" class="form-control mt-1 simple-textarea"></textarea>
          </div>
        </div>

        <div class="col-md-6">
          <div class="rating-group mb-3">
            <label class="d-block">Value for Money:</label>
            <small class="text-muted d-block mb-1">e.g., Worth the price, Affordable</small>
            <div class="stars mt-1" data-input-name="valueForMoney"></div>
            <input type="hidden" name="valueForMoney" value="0">
            <textarea name="valueForMoneyReason" placeholder="Reason (optional)" class="form-control mt-1 simple-textarea"></textarea>
          </div>

          <div class="rating-group mb-3">
            <label class="d-block">Staff Attitude:</label>
            <small class="text-muted d-block mb-1">e.g., Friendly, Helpful, Professional</small>
            <div class="stars mt-1" data-input-name="staffAttitude"></div>
            <input type="hidden" name="staffAttitude" value="0">
            <textarea name="staffAttitudeReason" placeholder="Reason (optional)" class="form-control mt-1 simple-textarea"></textarea>
          </div>

          <div class="rating-group mb-3">
            <label class="d-block">Bartender Attitude:</label>
            <small class="text-muted d-block mb-1">e.g., Friendly, Efficient, Skilled</small>
            <div class="stars mt-1" data-input-name="bartenderAttitude"></div>
            <input type="hidden" name="bartenderAttitude" value="0">
