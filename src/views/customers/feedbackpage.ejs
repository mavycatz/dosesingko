<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Customer Feedback</title>
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="shortcut icon" href="/images/iconup.png" type="image/png">

</head>
<style>
.back-home-link {
  text-decoration: none;
  margin-top: 2%;
  margin-bottom: 20px;
  margin-left: 70px;
  font-size: 1rem;
  color: black;
  display: inline-flex;
  align-items: center;
  transition: color 0.3s;
}
  @media (max-width: 768px) {
    .back-home-link {
      margin-top: 10px !important;
      margin-bottom: 5px !important;
    }
  }
.back-home-link:hover {
  color: gray;
}
.feedback-stats-container {
  width: 250px;
  padding: 20px;
  background-color: #f5f5f5;
  border-radius: 10px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  text-align: center;
  font-family: Arial, sans-serif;
}
.feedback-stats-container h2 {
  margin-bottom: 20px;
  font-size: 1.5rem;
}
.stat {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
  padding: 8px 0;
  border-bottom: 1px solid #ddd;
}
.stat-label {
  font-weight: 500;
  color: #555;
}
.stat-value {
  font-weight: bold;
  color: #222;
}
.stat:last-child {
  border-bottom: none;
}
.stars {
  display: inline-block;
}
.stars span {
  font-size: 2rem;
  cursor: pointer;
  color: white;
  -webkit-text-stroke: 1px gray;
}
.stars span.selected {
  color: black;
}

.simple-textarea {
  background-color: #f0f0f0;
  border: 1px solid #ccc;
  border-radius: 1rem; 
  padding: 0.5rem;
  height: 2.5rem;
  overflow: hidden;
  resize: none;
}
</style>
<body style="background-color: #f5f5f5;">
