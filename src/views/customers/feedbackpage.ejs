        <% groupedMenus[category].forEach(menu => { %>
          <div class="col-md-6 col-sm-12 mb-2">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="menuID[]" value="<%= menu._id %>" id="menu-<%= menu._id %>">
              <label class="form-check-label" for="menu-<%= menu._id %>">
                <%= menu.itemName %>
              </label>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
<% }) %>

<style>
  .transition {
    transition: transform 0.3s ease;
  }
  .rotate {
    transform: rotate(180deg);
  }
</style>



<div class="row mt-3 align-items-center">
